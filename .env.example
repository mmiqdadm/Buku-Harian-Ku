# Salin file ini menjadi .env lalu isi dengan konfigurasi Web App dari Firebase Console.
# Jika tidak diisi di .env, kamu tetap bisa mengisi konfigurasi Firebase langsung di dalam aplikasi (menu Hubungkan Cloud Firebase).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

