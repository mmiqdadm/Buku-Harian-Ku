rules_version = '2';

// ===============================================================
// Buku Harian Ku — Cloud Firestore Security Rules (Prototype)
// ===============================================================
//
// SECURITY ARCHITECTURE & AUTHENTICATION TRADEOFF:
// The parent explicitly opted out of login / PIN authentication
// ("tidak perlu pin") so young children (aged 6-10) can open the
// tablet and write diary entries immediately with zero login friction.
// Because Firebase Auth is intentionally not enabled (`request.auth`
// is null), read/write access on the three app collections below is
// NOT gated by user identity and relies on keeping this Firebase
// project URL and configuration private to the family's devices.
//
// Compensating controls enforced by these rules (for Buku Harian Ku):
//   1. Explicit default-deny on all collections/subcollections outside
//      the three `Buku Harian Ku` collections (`bhk_profiles`,
//      `bhk_entries`, `bhk_media`) and the five existing collections
//      coexisting on Firebase project `formal-office-ndw25` (`members`,
//      `admins`, `events`, `event_attendances`, `settings`).
//   2. Strict schema validation (`hasOnly` + `hasAll`), explicit CEL
//      type checks, enum allowlists, format regexes, and numeric bounds
//      enforced identically on BOTH `create` and `update` (Validator
//      Function Pattern — eliminates the Update Bypass vulnerability).
//   3. Strict per-field string length and list size limits to mitigate
//      resource exhaustion / 1 MiB payload DoS attacks.
//   4. Path-to-document-ID consistency and immutable key protection on
//      updates (`id`, `childId`, `createdAt` on entries; `id` on profiles;
//      `id`/`parentId`/`entryId`/`index` on media).
//   5. Hard deletes blocked on `bhk_profiles` and `bhk_entries` (app
//      uses soft-delete via `deleted: true`); hard deletes permitted
//      only on `bhk_media` to clean up media payloads of deleted entries.
//
// COEXISTENCE NOTE (`formal-office-ndw25`):
// This Firebase project is shared with an existing application that uses
// `members`, `admins`, `events`, `event_attendances`, and `settings`.
// Those five collections and their helpers (`isValidId`, `isValidMember`,
// `isValidAdmin`) are preserved verbatim below so deploying these rules
// does not break the existing app.
//
// Recommendation for broader sharing:
// If this app is ever shared beyond private family devices, enable
// Firebase Auth (e.g., Anonymous Auth + family household ID or Google
// Sign-In for parents) and Firebase App Check, and gate all rules with
// `isAuthenticated()` and ownership checks using the helpers below.
//
// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: bhk_profiles
// Document ID: {profileId} (e.g., 'umar', 'utsman', 'child_<uuid>')
// Operations: read (get/list), create, update (soft-delete via `deleted`); delete DENIED
// Fields:
//   - id: string (required, 1..80 chars, must equal profileId, immutable on update)
//   - name: string (required, 1..80 chars)
//   - nickname: string (required, 0..60 chars)
//   - birthDate: string (required, 0..20 chars)
//   - hobby: string (required, 0..150 chars)
//   - favoriteFood: string (required, 0..150 chars)
//   - favoriteColor: string (required, 0..80 chars)
//   - dream: string (required, 0..150 chars)
//   - aboutMe: string (required, 0..500 chars)
//   - avatarDataUrl: string (optional, 0..200000 chars, compressed base64 avatar)
//   - accentTone: string (required, enum: 'forest' | 'terracotta' | 'ochre' | 'slate')
//   - order: number (required, 0..1000)
//   - createdAt: number (required, positive epoch ms; mutable on profile update
//       ONLY because two devices independently seed default profiles 'umar'/'utsman'
//       with local Date.now() before their first cloud pull)
//   - updatedAt: number (required, positive epoch ms)
//   - deleted: bool (optional, soft-delete flag)
//   - syncStatus: string (required, enum: 'synced' | 'pending' | 'local-only')
//
// Collection: bhk_entries
// Document ID: {entryId} (random unique ID)
// Operations: read (get/list), create, update (soft-delete via `deleted`); delete DENIED
// Fields:
//   - id: string (required, 1..80 chars, must equal entryId, immutable on update)
//   - childId: string (required, 1..80 chars, immutable on update)
//   - dateKey: string (required, YYYY-MM-DD, must match monthKey prefix)
//   - monthKey: string (required, YYYY-MM)
//   - title: string (required, 0..200 chars)
//   - content: string (required, 0..50000 chars)
//   - attachments: list (required, size <= 20; items conform to MediaAttachment)
//   - createdAt: number (required, positive epoch ms, immutable on update)
//   - updatedAt: number (required, positive epoch ms)
//   - deleted: bool (optional, soft-delete flag)
//   - syncStatus: string (required, enum: 'synced' | 'pending' | 'local-only')
//
// Collection: bhk_media
// Document ID: {mediaDocId} (`<attId>` for main doc, `<attId>_part_<index>` for chunks)
// Operations: read (get/list), create, update, delete
// Shape A (Main media doc):
//   - id: string (required, 1..100 chars, must equal mediaDocId, immutable on update)
//   - entryId: string (required, 1..100 chars, immutable on update)
//   - type: string (required, enum: 'photo' | 'voice')
//   - mimeType: string (required, 1..100 chars)
//   - chunkCount: int (required, 1..10)
//   - chunk0: string (required, 0..750000 chars)
//   - updatedAt: number (required, positive epoch ms)
// Shape B (Continuation chunk doc):
//   - parentId: string (required, 1..100 chars, immutable on update)
//   - entryId: string (required, 1..100 chars, immutable on update)
//   - index: int (required, 1..9, immutable on update; mediaDocId == parentId + '_part_' + string(index))
//   - data: string (required, 1..750000 chars)
//
// Existing Coexisting Collections on `formal-office-ndw25` (Preserved Verbatim):
//   - members/{memberId}: nama (1..150), domisili (0..100), pendidikan (0..50), pembinaan (0..50)
//   - admins/{adminId}: username (3..50), name (2..100), passwordHash (string), role ('superadmin' | 'admin')
//   - events/{eventId}: validated by isValidId(eventId)
//   - event_attendances/{attendanceId}: validated by isValidId(attendanceId)
//   - settings/{settingId}: validated by isValidId(settingId)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Auth helpers (retained for future Firebase Auth hardening)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Schema & type helpers
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidString(val, minLen, maxLen) {
      return val is string &&
        val.size() >= minLen &&
        val.size() <= maxLen;
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
        (data[field] is string &&
         data[field].size() >= minLen &&
         data[field].size() <= maxLen);
    }

    function isValidOptionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function isValidOptionalNumber(data, field, minVal, maxVal) {
      return !(field in data) ||
        (data[field] is number &&
         data[field] >= minVal &&
         data[field] <= maxVal);
    }

    function isValidEpochMs(val) {
      return val is number && val > 0 && val < 10000000000000;
    }

    function isValidList(listVal, maxSize) {
      return listVal is list && listVal.size() <= maxSize;
    }

    function isValidSyncStatus(val) {
      return val in ['synced', 'pending', 'local-only'];
    }

    function isValidMonthKey(val) {
      return val is string &&
        val.matches('^\\d{4}-(0[1-9]|1[0-2])$');
    }

    function isValidDateKey(val, monthKey) {
      return val is string &&
        val.matches('^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$') &&
        isValidMonthKey(monthKey) &&
        val.matches('^' + monthKey + '-(0[1-9]|[12]\\d|3[01])$');
    }

    // ===============================================================
    // Domain Validators (Called in BOTH create and update rules)
    // ===============================================================

    function isValidProfile(data, profileId) {
      return hasOnlyAllowedFields(data, [
          'id', 'name', 'nickname', 'birthDate', 'hobby',
          'favoriteFood', 'favoriteColor', 'dream', 'aboutMe',
          'avatarDataUrl', 'accentTone', 'order',
          'createdAt', 'updatedAt', 'deleted', 'syncStatus'
        ]) &&
        hasRequiredFields(data, [
          'id', 'name', 'nickname', 'birthDate', 'hobby',
          'favoriteFood', 'favoriteColor', 'dream', 'aboutMe',
          'accentTone', 'order', 'createdAt', 'updatedAt', 'syncStatus'
        ]) &&
        isValidString(data.id, 1, 80) &&
        data.id == profileId &&
        isValidString(data.name, 1, 80) &&
        isValidString(data.nickname, 0, 60) &&
        isValidString(data.birthDate, 0, 20) &&
        isValidString(data.hobby, 0, 150) &&
        isValidString(data.favoriteFood, 0, 150) &&
        isValidString(data.favoriteColor, 0, 80) &&
        isValidString(data.dream, 0, 150) &&
        isValidString(data.aboutMe, 0, 500) &&
        isValidOptionalString(data, 'avatarDataUrl', 0, 200000) &&
        data.accentTone in ['forest', 'terracotta', 'ochre', 'slate'] &&
        data.order is number && data.order >= 0 && data.order <= 1000 &&
        isValidEpochMs(data.createdAt) &&
        isValidEpochMs(data.updatedAt) &&
        isValidOptionalBool(data, 'deleted') &&
        isValidSyncStatus(data.syncStatus);
    }

    function isValidAttachment(att) {
      return att is map &&
        hasOnlyAllowedFields(att, [
          'id', 'type', 'mimeType', 'durationSec',
          'caption', 'remoteSynced', 'remoteUrl', 'createdAt'
        ]) &&
        hasRequiredFields(att, ['id', 'type', 'mimeType', 'createdAt']) &&
        isValidString(att.id, 1, 100) &&
        att.type in ['photo', 'voice'] &&
        isValidString(att.mimeType, 1, 100) &&
        isValidOptionalNumber(att, 'durationSec', 0, 7200) &&
        isValidOptionalString(att, 'caption', 0, 300) &&
        isValidOptionalBool(att, 'remoteSynced') &&
        isValidOptionalString(att, 'remoteUrl', 0, 2048) &&
        isValidEpochMs(att.createdAt);
    }

    function isValidEntry(data, entryId) {
      return hasOnlyAllowedFields(data, [
          'id', 'childId', 'dateKey', 'monthKey', 'title', 'content',
          'attachments', 'createdAt', 'updatedAt', 'deleted', 'syncStatus'
        ]) &&
        hasRequiredFields(data, [
          'id', 'childId', 'dateKey', 'monthKey', 'title', 'content',
          'attachments', 'createdAt', 'updatedAt', 'syncStatus'
        ]) &&
        isValidString(data.id, 1, 80) &&
        data.id == entryId &&
        isValidString(data.childId, 1, 80) &&
        isValidMonthKey(data.monthKey) &&
        isValidDateKey(data.dateKey, data.monthKey) &&
        isValidString(data.title, 0, 200) &&
        isValidString(data.content, 0, 50000) &&
        // Firestore Rules CEL does not support iterating over lists of maps;
        // enforce strict list bound and validate the first attachment shape when present.
        isValidList(data.attachments, 20) &&
        (data.attachments.size() == 0 || isValidAttachment(data.attachments[0])) &&
        isValidEpochMs(data.createdAt) &&
        isValidEpochMs(data.updatedAt) &&
        isValidOptionalBool(data, 'deleted') &&
        isValidSyncStatus(data.syncStatus);
    }

    function isValidMainMediaDoc(data, mediaDocId) {
      return hasOnlyAllowedFields(data, [
          'id', 'entryId', 'type', 'mimeType', 'chunkCount', 'chunk0', 'updatedAt'
        ]) &&
        hasRequiredFields(data, [
          'id', 'entryId', 'type', 'mimeType', 'chunkCount', 'chunk0', 'updatedAt'
        ]) &&
        isValidString(data.id, 1, 100) &&
        data.id == mediaDocId &&
        isValidString(data.entryId, 1, 100) &&
        data.type in ['photo', 'voice'] &&
        isValidString(data.mimeType, 1, 100) &&
        data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 10 &&
        isValidString(data.chunk0, 0, 750000) &&
        isValidEpochMs(data.updatedAt);
    }

    function isValidMediaChunkDoc(data, mediaDocId) {
      return hasOnlyAllowedFields(data, [
          'parentId', 'entryId', 'index', 'data'
        ]) &&
        hasRequiredFields(data, [
          'parentId', 'entryId', 'index', 'data'
        ]) &&
        isValidString(data.parentId, 1, 100) &&
        isValidString(data.entryId, 1, 100) &&
        data.index is int && data.index >= 1 && data.index <= 9 &&
        mediaDocId == data.parentId + '_part_' + string(data.index) &&
        isValidString(data.data, 1, 750000);
    }

    function isValidMediaDoc(data, mediaDocId) {
      return isValidMainMediaDoc(data, mediaDocId) ||
        isValidMediaChunkDoc(data, mediaDocId);
    }

    function isValidMediaUpdate(newData, oldData, mediaDocId) {
      return (
        ('id' in oldData &&
         isValidMainMediaDoc(newData, mediaDocId) &&
         areImmutableFieldsUnchanged(['id', 'entryId'])) ||
        ('parentId' in oldData &&
         isValidMediaChunkDoc(newData, mediaDocId) &&
         areImmutableFieldsUnchanged(['parentId', 'entryId', 'index']))
      );
    }

    // ===============================================================
    // Existing App Helpers & Collections on formal-office-ndw25
    // ===============================================================

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidMember(data) {
      return data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 150
        && data.domisili is string && data.domisili.size() <= 100
        && data.pendidikan is string && data.pendidikan.size() <= 50
        && data.pembinaan is string && data.pembinaan.size() <= 50;
    }

    function isValidAdmin(data) {
      return data.username is string && data.username.size() >= 3 && data.username.size() <= 50
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.passwordHash is string
        && (data.role == 'superadmin' || data.role == 'admin');
    }

    // Existing app collections on formal-office-ndw25 (preserved untouched)
    match /members/{memberId} {
      allow read: if true;
      allow create, update: if isValidId(memberId) && isValidMember(request.resource.data);
      allow delete: if isValidId(memberId);
    }

    match /admins/{adminId} {
      allow read: if true;
      allow create, update: if isValidId(adminId) && isValidAdmin(request.resource.data);
      allow delete: if isValidId(adminId);
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isValidId(eventId);
    }

    match /event_attendances/{attendanceId} {
      allow read: if true;
      allow create, update, delete: if isValidId(attendanceId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    // ===============================================================
    // Collection Rules (Buku Harian Ku)
    // ===============================================================

    // 1. Child Profiles (no-auth family mode; soft-delete only)
    match /bhk_profiles/{profileId} {
      allow read: if true;
      allow create: if isValidProfile(request.resource.data, profileId);
      allow update: if isValidProfile(request.resource.data, profileId) &&
        areImmutableFieldsUnchanged(['id']);
      allow delete: if false;
    }

    // 2. Journal Entries (no-auth family mode; soft-delete only)
    match /bhk_entries/{entryId} {
      allow read: if true;
      allow create: if isValidEntry(request.resource.data, entryId);
      allow update: if isValidEntry(request.resource.data, entryId) &&
        areImmutableFieldsUnchanged(['id', 'childId', 'createdAt']);
      allow delete: if false;
    }

    // 3. Media Payloads & Chunks (no-auth family mode; supports cleanup deletes)
    match /bhk_media/{mediaDocId} {
      allow read: if true;
      allow create: if isValidMediaDoc(request.resource.data, mediaDocId);
      allow update: if isValidMediaUpdate(request.resource.data, resource.data, mediaDocId);
      allow delete: if true;
    }

    // ===============================================================
    // Explicit Default Deny (All Other Collections & Subcollections)
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
